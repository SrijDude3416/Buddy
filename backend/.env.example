# ---------------------------------------------------------------------------
# Copy to .env.local (gitignored) and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# --- MongoDB Atlas ---------------------------------------------------------
# From Atlas: Connect > Drivers. Contains a password — keep it out of git and
# out of chat logs.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=buddy

# --- Google OAuth (this is the CMU sign-in) --------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI on that client, exactly.
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Session ---------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 48
SESSION_SECRET=

# --- Access control --------------------------------------------------------
# Only these email domains may sign in. andrew.cmu.edu is what makes this
# "CMU SSO" — Andrew accounts are Google Workspace, so Google is authenticating
# against CMU's own directory. Add a domain here to let a judge or teammate in.
ALLOWED_EMAIL_DOMAINS=andrew.cmu.edu,cmu.edu

# Where to send the browser after a successful or failed sign-in. In dev this is
# the Vite server; in production it is your deployed origin.
APP_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# The gate. This is the only thing that has to change to move off dummy data.
# ---------------------------------------------------------------------------
# mock = every request is served from src/lib/mock (no network, simulated latency)
# live = every request is a real fetch against VITE_API_BASE_URL
VITE_API_MODE=mock

# Base URL for live mode. "/api" goes through the Vite dev proxy (see
# vite.config.js) to the Next.js backend; in production set the deployed origin.
VITE_API_BASE_URL=/api

# --- mock-mode knobs (ignored in live mode) --------------------------------
# Simulated round-trip latency in ms. Raise this to see loading states properly.
VITE_MOCK_LATENCY=450
# Fraction of mock requests that fail, 0..1. Use to exercise error + retry UI.
VITE_MOCK_ERROR_RATE=0
# Simulated CP-SAT solve time in ms for the generating screen.
VITE_MOCK_SOLVE_MS=4200

# --- live-mode knobs ------------------------------------------------------
# Per-request timeout in ms.
VITE_API_TIMEOUT=15000
# How often the generating screen polls an in-flight optimizer run.
VITE_RUN_POLL_INTERVAL=1200

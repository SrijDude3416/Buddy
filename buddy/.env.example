# Required for chat. Used only on the Next.js server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Get started and Demo do not require authentication or Google credentials.
# Live planner tasks/preferences use MONGODB_URI and MONGODB_DB from
# backend/.env.local. Set BUDDY_MONGODB_USER_ID in the Python environment
# to select another dataset (default: demo-carlos).

# Live class catalog. Demo always uses the built-in test catalog.
# Defaults to the `buddy` database on MONGODB_URI's cluster.
BUDDY_CATALOG_DB=buddy
SCHEDULE_MONGODB_URI=
SCHEDULE_MONGODB_DB=
SCHEDULE_MONGODB_COLLECTION=schedule

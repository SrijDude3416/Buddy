# Required for chat. Used only on the Next.js server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# The real Python preferences API and CP-SAT service.
FASTAPI_BASE_URL=http://127.0.0.1:8000

# --- CMU sign-in (Google OAuth) --------------------------------------------
# Leave these blank for the zero-config demo: in development the app then runs
# in demo mode and hands every visitor a fixed demo student. In production the
# same blank config fails CLOSED — a sign-in screen that explains what's missing
# rather than an app silently open to everyone.
#
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI on that client, exactly. Left blank it is
# derived from the request, which is what makes localhost work with no setup.
OAUTH_REDIRECT_URI=
# Signs the session cookie. 32+ chars: openssl rand -base64 48
SESSION_SECRET=
# Only these email domains may sign in. andrew.cmu.edu is what makes this "CMU
# sign-in" — Andrew accounts are Google Workspace, so Google authenticates
# against CMU's own directory. Add a domain to let a judge or teammate in.
ALLOWED_EMAIL_DOMAINS=andrew.cmu.edu,cmu.edu

# Optional. With a Mongo URI, sign-in upserts SCHEMA.md's `users` document and
# the session route reads through to it. Without one, the signed cookie is the
# whole user record — fine for the demo, see buddy/lib/auth/users.ts.
MONGODB_URI=
MONGODB_DB=buddy

# Escape hatch: run the no-login demo even when the Google client above is set.
# Used by the Playwright suite and for offline demoing.
BUDDY_ALLOW_DEMO=
